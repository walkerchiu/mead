# Docker Compose 環境變數 - Local 環境
# 複製此檔案為 .env.docker 並填入實際值
#
# 🔑 密碼生成命令: openssl rand -base64 24

# ==============================================
# TimescaleDB (PostgreSQL) 設定
# ==============================================
POSTGRES_USER=postgres
# 生成密碼: openssl rand -base64 24
# 預設密碼（請務必修改！）: CHANGEME_postgres_dev123
POSTGRES_PASSWORD=CHANGEME_postgres_dev123
POSTGRES_DB=mead_db
POSTGRES_PORT=5432

# ==============================================
# RabbitMQ 設定
# ==============================================
RABBITMQ_DEFAULT_USER=hq
# 生成密碼: openssl rand -base64 24
# 預設密碼（請務必修改！）: CHANGEME_rabbitmq_dev123
RABBITMQ_DEFAULT_PASS=CHANGEME_rabbitmq_dev123
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================
# Dragonfly (Redis) 設定
# ==============================================
REDIS_PORT=6379

# ==============================================
# Mailpit 設定
# ==============================================
MAIL_SMTP_PORT=1025
MAIL_WEB_PORT=8025

# ==============================================
# Adminer (DB GUI) 設定
# 預設 5556，避開 Prisma Studio 慣用的 5555。
# ==============================================
ADMINER_PORT=5556

# ==============================================
# SeaweedFS (S3 儲存) 設定
# ==============================================
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_MASTER_GRPC_PORT=19333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_VOLUME_GRPC_PORT=18080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_FILER_GRPC_PORT=18888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_USER=admin
# 生成密碼: openssl rand -base64 24
# 預設密碼（請務必修改！）: CHANGEME_seaweedfs_dev123
SEAWEEDFS_S3_PASSWORD=CHANGEME_seaweedfs_dev123

# ==============================================
# Frontend build flags（NEXT_PUBLIC_*，build 時由 frontend.build.args 烘進 client bundle）
# 容器化前端時這些值才會進 client bundle；host 跑 pnpm dev 不經此路徑。
# ==============================================
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_ENDPOINT=ws://localhost:4000/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MEAD (Local)
NEXT_PUBLIC_ENABLE_2FA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_SENTRY_DSN=
