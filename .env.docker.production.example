# Docker Compose 環境變數 - Production 環境
# 複製此檔案為 .env.docker 並填入實際值
# 🔐 填入實際值後的 .env.docker 絕對不可提交到版本控制
#
# 🔑 密碼生成命令: openssl rand -base64 48
#
# 注意：Production 部署建議走 Kubernetes/容器編排，多數服務透過 Service 內部 DNS
# 通訊，不需 host port expose。以下 *_PORT 僅當 docker-compose 直接部署時使用。

# ==============================================
# TimescaleDB (PostgreSQL) 設定
# ==============================================
POSTGRES_USER=npt_prod
POSTGRES_PASSWORD=CHANGE_ME_prod_strong_password_48chars!!
POSTGRES_DB=npt_db_production
POSTGRES_PORT=5432

# ==============================================
# RabbitMQ 設定
# ==============================================
RABBITMQ_DEFAULT_USER=npt_prod
RABBITMQ_DEFAULT_PASS=CHANGE_ME_prod_strong_password_48chars!!
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================
# Dragonfly (Redis) 設定
# ==============================================
REDIS_PORT=6379

# ==============================================
# Mailpit 設定（Production 不建議部署；使用真實 SMTP 服務）
# 若僅為 staging 壓測保留：
# ==============================================
MAIL_SMTP_PORT=1025
MAIL_WEB_PORT=8025

# ==============================================
# SeaweedFS (S3 儲存) 設定
# Production 強烈建議用 AWS S3 + IAM Role，不要部署 SeaweedFS
# 下列設定僅在必須自架時使用（--profile storage）
# ==============================================
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_MASTER_GRPC_PORT=19333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_VOLUME_GRPC_PORT=18080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_FILER_GRPC_PORT=18888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_USER=npt_prod
SEAWEEDFS_S3_PASSWORD=CHANGE_ME_prod_strong_password_48chars!!
