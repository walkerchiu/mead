# Docker Compose 環境變數 - UAT 環境
# 複製此檔案為 .env.docker 並填入實際值
#
# 🔑 密碼生成命令: openssl rand -base64 32

# ==============================================
# TimescaleDB (PostgreSQL) 設定
# ==============================================
POSTGRES_USER=wind_uat
POSTGRES_PASSWORD=CHANGE_ME_uat_strong_password_32chars!
POSTGRES_DB=wind_db_uat
POSTGRES_PORT=5432

# ==============================================
# RabbitMQ 設定
# ==============================================
RABBITMQ_DEFAULT_USER=wind_uat
RABBITMQ_DEFAULT_PASS=CHANGE_ME_uat_strong_password_32chars!
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================
# Dragonfly (Redis) 設定
# ==============================================
REDIS_PORT=6379
