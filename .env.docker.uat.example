# Docker Compose 環境變數 - UAT 環境
# 複製此檔案為 .env.docker 並填入實際值
# ⚠️ 填入實際值後的 .env.docker 不應提交到版本控制
#
# 🔑 密碼生成命令: openssl rand -base64 32

# ==============================================
# TimescaleDB (PostgreSQL) 設定
# ==============================================
POSTGRES_USER=mead_uat
POSTGRES_PASSWORD=CHANGE_ME_uat_strong_password_32chars!
POSTGRES_DB=mead_db_uat
POSTGRES_PORT=5432

# ==============================================
# RabbitMQ 設定
# ==============================================
RABBITMQ_DEFAULT_USER=mead_uat
RABBITMQ_DEFAULT_PASS=CHANGE_ME_uat_strong_password_32chars!
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================
# Dragonfly (Redis) 設定
# ==============================================
REDIS_PORT=6379

# ==============================================
# Mailpit 設定（UAT 可選，通常 UAT 走真實 SMTP；若部署 Mailpit 測試再啟用）
# ==============================================
MAIL_SMTP_PORT=1025
MAIL_WEB_PORT=8025

# ==============================================
# SeaweedFS (S3 儲存) 設定
# UAT 若改用 AWS S3 / MinIO，此區可留白（SeaweedFS profile 不啟動即可）
# 若仍用 docker-compose 的 SeaweedFS：--profile storage
# ==============================================
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_MASTER_GRPC_PORT=19333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_VOLUME_GRPC_PORT=18080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_FILER_GRPC_PORT=18888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_USER=mead_uat
SEAWEEDFS_S3_PASSWORD=CHANGE_ME_uat_strong_password_32chars!
