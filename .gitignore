.idea/
.vscode/
.cursor/
.claude/
.github/
*.swp
*.swo
*~

# Husky 內部 wrapper（auto-generated；.husky/ 本身要追蹤 hooks）
.husky/_/

# Playwright 產物
test-results/
playwright-report/
playwright/.cache/
# Playwright MCP 除錯產物（console log / page 快照）
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
!**/hq/logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Environment state
.current-env

# Temporary
tmp/
temp/

# Database backups
backups/

# Uploaded files (應使用外部儲存如 S3/SeaweedFS)
apps/backend/uploads/*
!apps/backend/uploads/README.md

# Python（scripts/check-drift.py 執行產物）
__pycache__/
*.pyc
*.pyo

# AWS bootstrap 一次性產物（DEPLOYMENT_NOTES.txt 的 heredoc 生成；非長期 source of truth）
*-policy.json
/trust-policy.json

# SSH 私鑰 / 憑證（絕不入庫）
*.pem
*.key

