# Backend 環境變數 - Local 環境
# 複製此檔案為 .env 並填入實際值
#
# 🔑 密碼/密鑰生成命令：
#   隨機密碼:     openssl rand -base64 24
#   JWT Secret:   openssl rand -base64 64
#   Encryption:   openssl rand -hex 32  （產生 64 字元 hex）

# ==============================================
# 服務器配置
# ==============================================
PORT=4000
NODE_ENV=development
# 前端網域（用於 Email 連結、密碼重設 URL、CORS 來源）
APP_URL=http://localhost:3000
# 多實例部署識別（log / trace；單機可留空）
# INSTANCE_ID=backend-1

# ==============================================
# 資料庫連線
# 支援本機 TimescaleDB / AWS RDS / Aurora / Cloud SQL / Azure / Supabase / Neon
# 詳見 docs/infrastructure/DATABASE_PROVIDERS.md
# ==============================================
# 密碼需與 .env.docker 的 POSTGRES_PASSWORD 一致
# 連線池參數說明:
#   connection_limit: 最大連線數（預設 10,建議根據應用規模調整）
#   pool_timeout: 等待連線的超時時間（秒,預設 10）
DATABASE_URL="postgresql://postgres:CHANGEME_postgres_dev123@localhost:5432/mead_db?schema=public&connection_limit=10&pool_timeout=10"
# 顯示在 pg_stat_activity / RDS Performance Insights；多實例部署可帶上 INSTANCE_ID
# DATABASE_APPLICATION_NAME=mead-backend
# SSL 模式：disable / prefer / require / verify-ca / verify-full
# 本機無 SSL 可留空；RDS/Aurora/Cloud SQL 建議 verify-full；Supabase/Neon require 即可
# DATABASE_SSL_MODE=
# verify-ca / verify-full 時二選一（擇優走 DATABASE_SSL_CA）
# DATABASE_SSL_CA_PATH=/etc/ssl/rds-combined-ca-bundle.pem
# DATABASE_SSL_CA=

# Prisma 慢查詢門檻（毫秒）；超過會在 log 中標記
PRISMA_SLOW_QUERY_THRESHOLD=1000

# ==============================================
# Redis / Dragonfly 快取
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# 本地 Dragonfly 預設無密碼；生產環境必填
# REDIS_PASSWORD=
# 可選：完整 Redis URL（system-monitor health-check 用；未設則略過）
# REDIS_URL=redis://localhost:6379

# ==============================================
# RabbitMQ 訊息佇列
# ==============================================
# 密碼需與 .env.docker 的 RABBITMQ_DEFAULT_PASS 一致
RABBITMQ_URL=amqp://hq:CHANGEME_rabbitmq_dev123@localhost:5672

# ==============================================
# JWT 認證
# ==============================================
# JWT Secret: 至少 64 字元，建議使用: openssl rand -base64 64
JWT_SECRET="Z2UDHFJDzWMYqF3vkRwcTCK5xfpHs1Mjyb/Mcarm6wfLjxFJkS6Xp2CeAWdvYfPkPQXiihqmPwbrEWcZxMocyA=="
# Access Token 過期時間（建議 15-30 分鐘）
JWT_EXPIRES_IN=15m
# Refresh Token 過期時間（建議 7 天）
JWT_REFRESH_EXPIRES_IN=7d
# JWT Refresh Secret（與 JWT_SECRET 不同）
JWT_REFRESH_SECRET="H+DH8lUTw+6SPGj/TPhToN+m0y+BDzOLdfbTckXNjRAf1dL7U7J/tSlpGr++R5qSEmFCtqEa5ZIFD5Gr95P/AQ=="

# ==============================================
# 資料加密（用於 TOTP Secret 等敏感欄位）
# ==============================================
# 必須為 64 字元 hex 字串（32 bytes），使用: openssl rand -hex 32
ENCRYPTION_KEY="5cde2e16ff8c15ba0661926b4247f6ef3f18358679a7475c197731ab8872942b"

# ==============================================
# 密碼重設
# ==============================================
PASSWORD_RESET_EXPIRE_MINUTES=60
# 可選，未設定時自動用 APP_URL/reset-password
# PASSWORD_RESET_URL=http://localhost:3000/reset-password
# 可選，重設連結允許的 host 白名單（逗號分隔）；未設時預設為 APP_URL 的 host
# ALLOWED_RESET_HOSTS=localhost:3000

# ==============================================
# CORS 設定
# ==============================================
# 未設定時自動使用 APP_URL，多個來源用逗號分隔
# 生產環境: 必須設為實際域名（使用 HTTPS）
# CORS_ORIGIN=http://localhost:3000

# ==============================================
# Email 配置
# ==============================================
# 郵件發送方式: graph (Microsoft Graph API) 或 smtp
MAIL_PROVIDER=smtp

# --- SMTP 設定（MAIL_PROVIDER=smtp 時使用）---
# 開發環境使用 Mailpit（本地 SMTP 測試服務器，由 docker-compose 啟動於 port 1025）
# Mailpit Web UI: http://localhost:8025
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME="MEAD (Local)"
MAIL_SECURE=false

# --- Microsoft Graph API 設定（MAIL_PROVIDER=graph 時使用）---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_FROM=

# --- 支援郵箱（顯示在通知信件中）---
SUPPORT_EMAIL=support@example.com

# ==============================================
# 通知開關（密碼重設連結、2FA 驗證碼為核心功能，不受這些旗標影響）
# ==============================================
# --- 郵件通知（true/false）---
MAIL_NOTIFY_PASSWORD_CHANGED=true
MAIL_NOTIFY_PROFILE_UPDATED=false
MAIL_NOTIFY_ACCOUNT_LOCKED=true
MAIL_NOTIFY_SESSION_REVOKED=false
MAIL_NOTIFY_BATCH_SESSIONS_REVOKED=false
MAIL_NOTIFY_PROPOSAL=true
MAIL_NOTIFY_ISSUE=true
MAIL_NOTIFY_PAT=true

# --- 系統通知：鈴鐺 + 通知中心（true/false）---
PUSH_NOTIFY_PASSWORD_CHANGED=true
PUSH_NOTIFY_ACCOUNT_LOCKED=true
PUSH_NOTIFY_SESSION_REVOKED=true
PUSH_NOTIFY_BATCH_SESSIONS_REVOKED=true
PUSH_NOTIFY_PROPOSAL_WORKFLOW=true
PUSH_NOTIFY_PROPOSAL_PARTICIPANT=true
PUSH_NOTIFY_CASE_WORKFLOW=true
PUSH_NOTIFY_ISSUE=true
PUSH_NOTIFY_JOURNAL=true
PUSH_NOTIFY_PAT=true

# ==============================================
# 檔案儲存設定
# ==============================================
# 儲存類型: local | s3 | seaweedfs
FILE_STORAGE_TYPE=seaweedfs

# 本地儲存（FILE_STORAGE_TYPE=local 時使用）
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:4000

# SeaweedFS / S3 設定（FILE_STORAGE_TYPE=seaweedfs 或 s3 時使用）
# SeaweedFS 本地開發：使用 docker-compose 啟動
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=admin
# 密碼需與 .env.docker 的 SEAWEEDFS_S3_PASSWORD 一致
S3_SECRET_ACCESS_KEY=CHANGEME_seaweedfs_dev123
S3_BUCKET=mead-documents
S3_REGION=us-east-1
# 是否強制使用路徑風格（SeaweedFS 需要設為 true）
S3_FORCE_PATH_STYLE=true
# 檔案公開訪問 URL 前綴（可選，用於 CDN）
S3_PUBLIC_URL_PREFIX=

# ==============================================
# GraphQL 設定
# ==============================================
# Query Complexity 限制（防止過於複雜的查詢）
GRAPHQL_MAX_COMPLEXITY=1000
# 記錄高複雜度查詢的閾值
GRAPHQL_COMPLEXITY_LOG_THRESHOLD=500

# ==============================================
# 日誌設定
# ==============================================
# 是否啟用檔案日誌（生產環境預設啟用）
ENABLE_FILE_LOGGING=false
# 日誌目錄（預設: ./logs）
LOG_DIR=./logs
# 單個日誌檔案最大大小
LOG_MAX_SIZE=20m
# 日誌保留天數
LOG_MAX_FILES=14d
# 是否在錯誤訊息中顯示 Stack Trace（僅開發環境，需明確啟用）
SHOW_STACK_TRACE=false

# ==============================================
# GeoIP 地理位置設定
# ==============================================
# GeoLite2 資料庫路徑（用於 Session 地理位置查詢）
# 完整配置指南：docs/infrastructure/GEOIP_LOCATION_SETUP.md
# 開發環境：可選（本地 IP 自動標記為 "Local"）
# 生產環境：必須配置
GEOIP_DB_PATH=./data/geoip/GeoLite2-City.mmdb

# ==============================================
# TLS 自動化（單一 / 多 domain 憑證簽發 + 儲存抽象）
# ==============================================
#
# Provider 選擇：letsencrypt（預設）| cloudflare | aws-acm
TLS_PROVIDER=letsencrypt

# --- Let's Encrypt（預設 provider）---
# 正式：https://acme-v02.api.letsencrypt.org/directory
# 測試：https://acme-staging-v02.api.letsencrypt.org/directory（首次上線務必先用 staging）
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CONTACT_EMAIL=ops@example.com

# --- Cloudflare（TLS_PROVIDER=cloudflare 時）---
# CF_CERT_MODE：origin-ca（預設，給 origin server）| universal-ssl（CF 邊緣自動簽）
CF_CERT_MODE=origin-ca
# Origin CA 憑證效期（天）；選 7, 30, 90, 365, 730, 1095, 5475；預設 365
CF_CERT_VALIDITY_DAYS=365
CF_API_TOKEN=
CF_ZONE_ID=

# --- AWS ACM（TLS_PROVIDER=aws-acm 時）---
AWS_ACM_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 優先由 instance profile / shared credentials 解析；
# 開發環境可直接填：
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SecretStore ---
# TLS_SECRET_STORE：file（預設，dev；production 啟動會 throw）| aws-secrets-manager | vault
TLS_SECRET_STORE=file
# FileSecretStore（僅 file 時使用）
TLS_SECRET_DIR=.dev-secrets
# AwsSecretsManagerSecretStore（僅 aws-secrets-manager 時使用；AWS 部署推薦）
AWS_SECRETS_MANAGER_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=mead/dev
# VaultSecretStore（僅 vault 時使用；自管 / non-AWS 推薦）
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=                # token auth（dev / staging）— 或走下方 AppRole
# VAULT_ROLE_ID=              # AppRole auth（production 推薦）
# VAULT_SECRET_ID=
# VAULT_MOUNT=secret          # KV v2 mount path（default: secret）
# VAULT_PATH_PREFIX=mead/dev

# --- DNS provider for ACME DNS-01 challenge ---
# 值：manual（預設，log-only，用戶自行加 TXT）| cloudflare | route53 | google-cloud-dns
DEFAULT_DNS_PROVIDER=manual
# cloudflare：用上方 CF_API_TOKEN（可選 CF_ZONE_ID）
# route53：用上方 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY（可選 ROUTE53_HOSTED_ZONE_ID 鎖定單一 zone）
# ROUTE53_HOSTED_ZONE_ID=
# google-cloud-dns：service account JSON 以字串傳入（建議 K8s Secret 注入）
# GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_MANAGED_ZONE=
