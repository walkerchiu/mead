# Backend 環境變數 - Production 環境
# 複製此檔案為 .env 並填入實際值
# 🔐 填入實際值後的 .env 絕對不可提交到版本控制
#
# 🔑 密碼/密鑰生成命令：
#   隨機密碼:     openssl rand -base64 24
#   JWT Secret:   openssl rand -hex 64
#   Encryption:   openssl rand -hex 32  （產生 64 字元 hex）

# ==============================================
# 服務器配置
# ==============================================
PORT=4000
NODE_ENV=production
# 前端網域（用於 Email 連結、密碼重設 URL、CORS 來源）
APP_URL=https://yourapp.com
# 多實例部署識別（log / trace；多 replica 必填）
INSTANCE_ID=backend-prod-1

# ==============================================
# 資料庫連線
# 支援 AWS RDS / Aurora / Cloud SQL / Azure / Supabase / Neon
# 詳見 docs/infrastructure/DATABASE_PROVIDERS.md
# ==============================================
# 連線池參數說明:
#   connection_limit: 最大連線數（生產環境建議 20+）
#   pool_timeout: 等待連線的超時時間（秒,預設 10）
DATABASE_URL="postgresql://npt_prod:CHANGE_ME_prod_strong_password_48chars!!@prod-db-host:5432/npt_db_production?schema=public&sslmode=verify-full&connection_limit=20&pool_timeout=10"
DATABASE_APPLICATION_NAME=npt-backend-prod
# SSL 模式：production 必用 verify-full
DATABASE_SSL_MODE=verify-full
# CA bundle（AWS RDS / Aurora 用 global bundle；Cloud SQL 用 server-ca.pem；Azure 用 DigiCert root）
DATABASE_SSL_CA_PATH=/etc/ssl/rds-combined-ca-bundle.pem
# 或 K8s Secret / Vault 注入 PEM 字串
# DATABASE_SSL_CA=

# Prisma 慢查詢門檻（毫秒）；Production 建議 500ms
PRISMA_SLOW_QUERY_THRESHOLD=500

# ==============================================
# Redis / Dragonfly 快取
# ==============================================
REDIS_HOST=prod-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_prod_redis_password
# REDIS_URL=rediss://:CHANGE_ME_prod_redis_password@prod-redis-host:6379

# ==============================================
# RabbitMQ 訊息佇列
# ==============================================
RABBITMQ_URL=amqps://npt_prod:CHANGE_ME_prod_strong_password_48chars!!@prod-rabbitmq-host:5671

# ==============================================
# JWT 認證
# ==============================================
# JWT Secret: 至少 64 字元，建議使用: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_prod_jwt_secret_at_least_64_chars"
# Access Token 過期時間（生產環境建議 15 分鐘）
JWT_EXPIRES_IN=15m
# Refresh Token 過期時間（生產環境建議 7 天）
JWT_REFRESH_EXPIRES_IN=7d
# JWT Refresh Secret（與 JWT_SECRET 不同）
JWT_REFRESH_SECRET="CHANGE_ME_prod_jwt_refresh_secret_at_least_64_chars"

# ==============================================
# 資料加密（用於 TOTP Secret 等敏感欄位）
# ==============================================
# 必須為 64 字元 hex 字串（32 bytes），使用: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_prod_encryption_key"

# ==============================================
# 密碼重設
# ==============================================
PASSWORD_RESET_EXPIRE_MINUTES=15
# 可選，未設定時自動用 APP_URL/reset-password
# PASSWORD_RESET_URL=https://yourapp.com/reset-password
# 可選，重設連結允許的 host 白名單（逗號分隔）；未設時預設為 APP_URL 的 host
ALLOWED_RESET_HOSTS=yourapp.com

# ==============================================
# CORS 設定
# ==============================================
# 未設定時自動使用 APP_URL，多個來源用逗號分隔
# 生產環境: 必須設為實際域名（使用 HTTPS）
CORS_ORIGIN=https://yourapp.com

# ==============================================
# Email 配置
# ==============================================
# 郵件發送方式: graph (Microsoft Graph API) 或 smtp
MAIL_PROVIDER=graph

# --- SMTP 設定（MAIL_PROVIDER=smtp 時使用）---
# 生產環境必須使用真實 SMTP 服務器
MAIL_HOST=smtp.yourapp.com
MAIL_PORT=587
MAIL_USER=noreply@yourapp.com
MAIL_PASSWORD=CHANGE_ME_prod_mail_password
MAIL_FROM=noreply@yourapp.com
MAIL_FROM_NAME="NPT"
MAIL_SECURE=true

# --- Microsoft Graph API 設定 ---
GRAPH_TENANT_ID=CHANGE_ME
GRAPH_CLIENT_ID=CHANGE_ME
GRAPH_CLIENT_SECRET=CHANGE_ME
GRAPH_MAIL_FROM=noreply@yourapp.com

# --- 支援郵箱（顯示在通知信件中）---
SUPPORT_EMAIL=support@yourapp.com

# ==============================================
# 通知開關（密碼重設連結、2FA 驗證碼為核心功能，不受這些旗標影響）
# ==============================================
# --- 郵件通知（true/false）---
MAIL_NOTIFY_PASSWORD_CHANGED=true
MAIL_NOTIFY_PROFILE_UPDATED=false
MAIL_NOTIFY_ACCOUNT_LOCKED=true
MAIL_NOTIFY_SESSION_REVOKED=false
MAIL_NOTIFY_BATCH_SESSIONS_REVOKED=false
MAIL_NOTIFY_PROPOSAL=true
MAIL_NOTIFY_ISSUE=true
MAIL_NOTIFY_PAT=true

# --- 系統通知：鈴鐺 + 通知中心（true/false）---
PUSH_NOTIFY_PASSWORD_CHANGED=true
PUSH_NOTIFY_ACCOUNT_LOCKED=true
PUSH_NOTIFY_SESSION_REVOKED=true
PUSH_NOTIFY_BATCH_SESSIONS_REVOKED=true
PUSH_NOTIFY_PROPOSAL_WORKFLOW=true
PUSH_NOTIFY_PROPOSAL_PARTICIPANT=true
PUSH_NOTIFY_CASE_WORKFLOW=true
PUSH_NOTIFY_ISSUE=true
PUSH_NOTIFY_JOURNAL=true
PUSH_NOTIFY_PAT=true

# ==============================================
# 檔案儲存設定
# ==============================================
# 儲存類型: local | s3 | seaweedfs
FILE_STORAGE_TYPE=s3

# 本地儲存（FILE_STORAGE_TYPE=local 時使用，生產環境不建議）
UPLOAD_DIR=/var/lib/npt/uploads
BASE_URL=https://yourapp.com

# SeaweedFS / S3 設定
S3_ENDPOINT=https://s3.ap-northeast-1.amazonaws.com
S3_ACCESS_KEY_ID=CHANGE_ME_prod_s3_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_prod_s3_secret_key
S3_BUCKET=npt-prod-documents
S3_REGION=ap-northeast-1
# AWS S3 可 false；SeaweedFS / MinIO 必須 true
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL_PREFIX=https://cdn.yourapp.com

# ==============================================
# GraphQL 設定
# ==============================================
# Query Complexity 限制（防止過於複雜的查詢）
# 生產環境建議較低的複雜度上限
GRAPHQL_MAX_COMPLEXITY=500
# 記錄高複雜度查詢的閾值
GRAPHQL_COMPLEXITY_LOG_THRESHOLD=300

# ==============================================
# 日誌設定
# ==============================================
# 是否啟用檔案日誌（生產環境必須啟用）
ENABLE_FILE_LOGGING=true
# 日誌目錄
LOG_DIR=/var/log/npt-backend
# 單個日誌檔案最大大小
LOG_MAX_SIZE=50m
# 日誌保留天數
LOG_MAX_FILES=30d
# 是否在錯誤訊息中顯示 Stack Trace（生產環境必須禁用）
SHOW_STACK_TRACE=false

# ==============================================
# GeoIP 地理位置設定
# ==============================================
# GeoLite2 資料庫路徑（用於 Session 地理位置查詢）
# 完整配置指南：docs/infrastructure/GEOIP_LOCATION_SETUP.md
# 生產環境：必須配置
GEOIP_DB_PATH=/var/lib/npt/geoip/GeoLite2-City.mmdb


# ==============================================
# TLS 自動化（單一 / 多 domain 憑證簽發 + 儲存抽象）
# ==============================================
# 詳細設定：docs/operations/TLS_AUTOMATION.md
#
# Provider 選擇：letsencrypt（預設）| cloudflare | aws-acm
TLS_PROVIDER=letsencrypt

# --- Let's Encrypt（預設 provider）---
# 正式：https://acme-v02.api.letsencrypt.org/directory
# 測試：https://acme-staging-v02.api.letsencrypt.org/directory（首次上線務必先用 staging）
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CONTACT_EMAIL=ops@example.com

# --- Cloudflare（TLS_PROVIDER=cloudflare 時）---
CF_CERT_MODE=origin-ca
CF_CERT_VALIDITY_DAYS=365
CF_API_TOKEN=
CF_ZONE_ID=

# --- AWS ACM（TLS_PROVIDER=aws-acm 時）---
AWS_ACM_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SecretStore ---
TLS_SECRET_STORE=file
TLS_SECRET_DIR=.dev-secrets
AWS_SECRETS_MANAGER_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=npt/dev
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_MOUNT=secret
# VAULT_PATH_PREFIX=npt/dev

# --- DNS provider for ACME DNS-01 challenge ---
# 值：manual（預設，log-only）| cloudflare | route53 | google-cloud-dns
DEFAULT_DNS_PROVIDER=manual
# cloudflare：用上方 CF_API_TOKEN（可選 CF_ZONE_ID）
# route53：用上方 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY（可選 ROUTE53_HOSTED_ZONE_ID）
# ROUTE53_HOSTED_ZONE_ID=
# google-cloud-dns：service account JSON 以字串傳入（建議 K8s Secret / Vault 注入）
# GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_MANAGED_ZONE=
