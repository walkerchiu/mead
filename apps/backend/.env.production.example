# Backend 環境變數 - Production 環境
# 複製此檔案為 .env 並填入實際值
# 🔐 填入實際值後的 .env 絕對不可提交到版本控制
#
# 🔑 密碼/密鑰生成命令：
#   隨機密碼:     openssl rand -base64 24
#   JWT Secret:   openssl rand -hex 64
#   Encryption:   openssl rand -hex 32  （產生 64 字元 hex）

# ==============================================
# 服務器配置
# ==============================================
PORT=4000
NODE_ENV=production

# ==============================================
# 資料庫連線
# ==============================================
DATABASE_URL="postgresql://starter_prod:CHANGE_ME_prod_strong_password_48chars!!@prod-db-host:5432/starter_db_production?schema=public&sslmode=require"

# ==============================================
# JWT 認證
# ==============================================
# JWT Secret: 至少 64 字元，使用: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_prod_jwt_secret_at_least_64_chars"
# Access Token 過期時間（生產環境建議 15 分鐘）
JWT_EXPIRES_IN=15m
# Refresh Token 過期時間（生產環境建議 7 天）
JWT_REFRESH_EXPIRES_IN=7d
# JWT Refresh Secret（與 JWT_SECRET 不同）
JWT_REFRESH_SECRET="CHANGE_ME_prod_jwt_refresh_secret_at_least_64_chars"

# ==============================================
# 資料加密（用於 TOTP Secret 等敏感欄位）
# ==============================================
# 必須為 64 字元 hex 字串（32 bytes），使用: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_prod_encryption_key"

# ==============================================
# Redis / Dragonfly 快取
# ==============================================
REDIS_HOST=prod-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_prod_redis_password

# ==============================================
# RabbitMQ 訊息佇列
# ==============================================
RABBITMQ_URL=amqp://starter_prod:CHANGE_ME_prod_strong_password_48chars!!@prod-rabbitmq-host:5672

# ==============================================
# Email 配置
# ==============================================
# 生產環境必須使用真實的 SMTP 服務器（如 AWS SES, SendGrid, Mailgun 等）
MAIL_HOST=smtp.yourapp.com
MAIL_PORT=587
MAIL_USER=noreply@yourapp.com
MAIL_PASSWORD=CHANGE_ME_prod_mail_password
MAIL_FROM=noreply@yourapp.com
MAIL_FROM_NAME="Starter"
MAIL_SECURE=true

# ==============================================
# 密碼重設
# ==============================================
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_URL=https://yourapp.com/reset-password

# ==============================================
# CORS 設定
# ==============================================
CORS_ORIGIN=https://yourapp.com

# ==============================================
# GraphQL 設定
# ==============================================
GRAPHQL_MAX_COMPLEXITY=500
GRAPHQL_COMPLEXITY_LOG_THRESHOLD=300

# ==============================================
# 日誌設定（生產環境）
# ==============================================
ENABLE_FILE_LOGGING=true
LOG_DIR=/var/log/starter-backend
LOG_MAX_SIZE=50m
LOG_MAX_FILES=30d
SHOW_STACK_TRACE=false

# ==============================================
# GeoIP 地理位置設定
# ==============================================
# GeoLite2 資料庫路徑（用於 Session 地理位置查詢）
# 完整配置指南：docs/infrastructure/GEOIP_LOCATION_SETUP.md
# 開發環境：可選（本地 IP 自動標記為 "Local"）
# 生產環境：必須配置
# 下載後將 GeoLite2-City.mmdb 放到 apps/backend/data/geoip/ 目錄
GEOIP_DB_PATH=./data/geoip/GeoLite2-City.mmdb
