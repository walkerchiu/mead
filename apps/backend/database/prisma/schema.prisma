  /// 記錄建立時間
  createdAt   DateTime    @default(now()) @map("created_at")

  // === 關聯 ===
  /// 角色權限關聯（多對多）
  rolePermissions RolePermission[]

  // === 索引和約束 ===
  /// 同一個權限名稱可在不同 scope 存在（例如：HQ_SCOPE 的 users:read 和 CUSTOMER_SCOPE 的 users:read）
  @@unique([name, scope], name: "name_scope")
  @@index([resource, action])
  @@index([scope])
  @@index([resource])
  @@map("permissions")
}

