// Cron Job 配置管理
// 管理 Cron Job 的排程、告警規則和執行設定

model CronJobConfig {
  id          String   @id @default(uuid())

  // Job 識別（唯一）
  jobName     String   @unique @db.VarChar(100)  // 例如: 'cleanup-expired-sessions'
  displayName String   @db.VarChar(200)          // 顯示名稱
  description String?  @db.Text                  // 詳細描述
  jobType     String   @db.VarChar(50)           // 例如: 'cleanup', 'archiving', 'notification'
  category    String   @db.VarChar(50)           // 分類: 'maintenance', 'monitoring', 'notification'

  // 排程設定
  cronExpression String  @db.VarChar(100)        // Cron 表達式
  timeZone       String  @default("Asia/Taipei") @db.VarChar(50)
  isEnabled      Boolean @default(true)          // 是否啟用

  // 告警設定
  alertOnFailure       Boolean @default(true)   // 失敗時告警
  alertOnTimeout       Boolean @default(true)   // 超時時告警
  failureThreshold     Int     @default(1)      // 連續失敗幾次後告警
  timeoutThresholdMs   Int?                     // 執行時間超過多少毫秒視為超時
  alertRecipients      Json?                    // 告警收件人列表 (emails, webhooks)
  alertMethods         Json?                    // 告警方式: ['email', 'webhook', 'system']

  // 執行設定
  maxExecutionTimeMs Int?                       // 最大執行時間（毫秒）
  retryOnFailure     Boolean @default(false)    // 失敗時是否重試
  maxRetries         Int     @default(0)        // 最大重試次數
  retryDelayMs       Int     @default(60000)    // 重試延遲（毫秒）
  concurrencyControl Boolean @default(true)     // 是否使用分散式鎖

  // 統計資料（由系統更新）
  lastExecutedAt     DateTime?                  // 最後執行時間
  lastStatus         CronJobStatus?             // 最後執行狀態
  lastDuration       Int?                       // 最後執行時長（毫秒）
  lastErrorMessage   String?   @db.Text         // 最後錯誤訊息
  nextRunAt          DateTime?                  // 下次執行時間
  consecutiveFailures Int     @default(0)       // 連續失敗次數
  totalExecutions    Int      @default(0)       // 總執行次數
  totalFailures      Int      @default(0)       // 總失敗次數

  // 審計欄位
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)           // 創建者 ID
  updatedBy String?  @db.VarChar(100)           // 更新者 ID

  // 索引優化
  @@index([isEnabled])
  @@index([category])
  @@index([nextRunAt])
  @@map("cron_job_configs")
}
