// Metric - TimescaleDB 時間序列資料
model Metric {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  value     Float
  tags      Json?
  timestamp DateTime @default(now())

  // 索引（時間序列優化）
  @@index([timestamp(sort: Desc)])
  @@index([name, timestamp(sort: Desc)])
  @@map("metrics")
}
