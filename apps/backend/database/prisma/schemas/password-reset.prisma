// PasswordReset - 密碼重置請求
// 用於安全的密碼重置流程，採用一次性 token 機制
model PasswordReset {
  /// 密碼重置記錄唯一識別碼（UUID v7）
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  /// 請求重置密碼的用戶 ID
  userId    String    @map("user_id") @db.Uuid

  /// 重置 Token 的雜湊值（bcrypt hash，原始 token 僅在 email 中發送）
  token     String    @unique

  /// Token 過期時間（預設 30 分鐘）
  expiresAt DateTime  @map("expires_at")

  /// Token 使用時間戳記（null 表示未使用，非 null 表示已使用且不可重複使用）
  usedAt    DateTime? @map("used_at")

  /// 請求來源 IP 位址（用於安全審計）
  ipAddress String?   @map("ip_address")

  /// 記錄建立時間
  createdAt DateTime  @default(now()) @map("created_at")

  // === 關聯 ===
  /// 關聯的用戶（Cascade 刪除：刪除用戶時自動刪除所有重置記錄）
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // === 索引（優化查詢效能）===
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([createdAt(sort: Desc)])
  @@map("password_resets")
}
