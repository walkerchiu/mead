// PersonalAccessToken - 個人存取權杖
// 用於 API 認證，讓用戶透過外部工具（CLI、腳本）存取系統

model PersonalAccessToken {
  /// 權杖唯一識別碼（UUID v7）
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  /// 關聯的用戶 ID
  userId      String    @map("user_id") @db.Uuid

  /// 用戶自訂名稱（如「同步腳本」）
  name        String    @db.VarChar(100)

  /// Token 的 SHA-256 雜湊值（不可逆）
  tokenHash   String    @unique @map("token_hash") @db.Text

  /// Token 前綴（供列表識別，如「mead_a1b2c3d」）
  tokenPrefix String    @map("token_prefix") @db.VarChar(12)

  /// 授權範圍（依 ALLOWED_SCOPES 白名單而定）
  scopes      String[]  @default([])

  /// 最後使用時間
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)

  /// 最後使用的 IP 位址
  lastUsedIp  String?   @map("last_used_ip")

  /// 到期時間
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)

  /// 記錄建立時間
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  /// 撤銷時間（null 表示有效）
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  // === 關聯 ===
  /// 關聯的用戶
  user User @relation("UserPersonalAccessTokens", fields: [userId], references: [id], onDelete: Cascade)

  // === 索引 ===
  @@index([userId, revokedAt])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}
