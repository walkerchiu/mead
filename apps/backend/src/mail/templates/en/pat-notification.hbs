<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{subject}}</title>
    <style>
      body {
        font-family:
          -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        margin: 0;
        padding: 0;
        background-color: #f4f6f9;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }
      .header {
        background-color: #1a365d;
        color: white;
        padding: 28px 24px;
        text-align: center;
      }
      .header h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
      }
      .content {
        padding: 32px 24px;
      }
      .content p {
        margin: 0 0 16px;
      }
      .info-box {
        background-color: #f7f8fa;
        border-left: 4px solid #2b6cb0;
        padding: 14px 16px;
        margin: 20px 0;
        border-radius: 4px;
      }
      .info-box h3 {
        margin: 0 0 10px;
        font-size: 16px;
        color: #1a365d;
      }
      .info-box ul {
        margin: 8px 0 0;
        padding-left: 20px;
      }
      .info-box li {
        margin: 4px 0;
      }
      .warning {
        background-color: #fffbeb;
        border-left: 4px solid #d69e2e;
        padding: 14px 16px;
        margin: 20px 0;
        border-radius: 4px;
      }
      .footer {
        background-color: #f7f8fa;
        padding: 20px 24px;
        text-align: center;
        font-size: 12px;
        color: #888;
        border-top: 1px solid #e8ecf1;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        {{#if isCreated}}
          <h2>🔑 Personal Access Token Created</h2>
        {{else}}
          <h2>🔒 Personal Access Token Revoked</h2>
        {{/if}}
      </div>

      <div class='content'>
        <p>Dear {{userName}},</p>

        {{#if isCreated}}
          <p>A new personal access token has been created for your account.</p>
        {{else}}
          <p>One of your personal access tokens has been revoked and can no
            longer be used.</p>
        {{/if}}

        <div class='info-box'>
          <h3>Token Information</h3>
          <ul>
            <li><strong>Name:</strong> {{tokenName}}</li>
            <li><strong>Prefix:</strong> {{tokenPrefix}}...</li>
            {{#if scopes}}<li><strong>Scopes:</strong> {{scopes}}</li>{{/if}}
            {{#if expiresAt}}<li><strong>Expires at:</strong>
                {{expiresAt}}</li>{{/if}}
            <li><strong>Timestamp:</strong> {{timestamp}}</li>
          </ul>
        </div>

        <div class='warning'>
          <strong>⚠️ Security Notice:</strong>
          {{#if isCreated}}
            <p style='margin: 8px 0 0;'>Keep your token secure and never share
              it with others. If you did not perform this action, please revoke
              the token immediately and contact support.</p>
          {{else}}
            <p style='margin: 8px 0 0;'>If you did not perform this action, your
              account may have been compromised. Please change your password
              immediately and contact support.</p>
          {{/if}}
        </div>

        <p><strong>Support Email:</strong>
          <a
            href='mailto:{{supportEmail}}'
            style='color: #2b6cb0;'
          >{{supportEmail}}</a></p>
        <p style='text-align: center; margin-top: 24px;'>
          <a
            href='{{dashboardUrl}}'
            style='display: inline-block; padding: 12px 32px; background-color: #2b6cb0; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;'
          >Go to Dashboard</a>
        </p>
      </div>

      <div class='footer'>
        <p>This email was sent automatically. Please do not reply directly.</p>
        <p>&copy; 2026 Intelligent Cloud Plus, Inc. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>