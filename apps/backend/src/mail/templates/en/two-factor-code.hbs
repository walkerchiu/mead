<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Two-Factor Authentication Code</title>
    <style>
      body { font-family: -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; background-color: #f4f6f9; }
      .container { max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); }
      .header { background-color: #1a365d; color: white; padding: 28px 24px; text-align: center; }
      .header h2 { margin: 0; font-size: 22px; font-weight: 600; }
      .content { padding: 32px 24px; }
      .content p { margin: 0 0 16px; }
      .verification-code { background: #f7f8fa; border: 2px dashed #2b6cb0; border-radius: 8px; padding: 28px; text-align: center; margin: 24px 0; }
      .code { font-size: 36px; font-weight: bold; color: #1a365d; letter-spacing: 8px; font-family: 'Courier New', monospace; }
      .code-hint { font-size: 12px; color: #888; margin-top: 10px; }
      .info { background-color: #ebf4ff; border-left: 4px solid #2b6cb0; padding: 14px 16px; margin: 20px 0; border-radius: 4px; font-size: 14px; }
      .info ul { margin: 8px 0 0; padding-left: 20px; }
      .info li { margin: 4px 0; }
      .warning { background-color: #fffbeb; border-left: 4px solid #d69e2e; padding: 14px 16px; margin: 20px 0; border-radius: 4px; }
      .warning ul { margin: 8px 0 0; padding-left: 20px; }
      .warning li { margin: 4px 0; }
      .meta { font-size: 12px; color: #888; margin-top: 24px; }
      .footer { background-color: #f7f8fa; padding: 20px 24px; text-align: center; font-size: 12px; color: #888; border-top: 1px solid #e8ecf1; }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h2>🔐 Two-Factor Authentication</h2>
      </div>

      <div class='content'>
        <p>Hello, {{name}}!</p>

        {{#if (eq purpose 'LOGIN')}}
          <p>You are attempting to sign in to your account. Please use the following verification code to complete the login:</p>
        {{else if (eq purpose 'ENABLE')}}
          <p>You are enabling two-factor authentication. Please use the following verification code to complete the setup:</p>
        {{else if (eq purpose 'DISABLE')}}
          <p>You are disabling two-factor authentication. Please use the following verification code to confirm:</p>
        {{/if}}

        <div class='verification-code'>
          <div style='font-size: 14px; color: #666; margin-bottom: 10px;'>Verification Code</div>
          <div class='code'>{{code}}</div>
          <div class='code-hint'>This code will expire in {{expiryMinutes}} minutes</div>
        </div>

        <div class='info'>
          <strong>📋 Instructions:</strong>
          <ul>
            <li>Enter this code within <strong>{{expiryMinutes}} minutes</strong></li>
            <li>The code can only be used once</li>
            <li>The code is case-sensitive</li>
            <li>Maximum 5 attempts allowed</li>
          </ul>
        </div>

        <div class='warning'>
          <strong>⚠️ Security Reminder:</strong>
          <ul>
            <li><strong>Do not</strong> share this code with anyone</li>
            <li>If you did not initiate this, please contact us immediately</li>
            <li>Please review your account security</li>
          </ul>
        </div>

        <div class='meta'>
          <strong>Request Information:</strong><br />
          Time: {{timestamp}}<br />
          {{#if ipAddress}}IP Address: {{ipAddress}}{{/if}}
        </div>
        <p style='text-align: center; margin-top: 24px;'>
          <a href='{{dashboardUrl}}' style='display: inline-block; padding: 12px 32px; background-color: #2b6cb0; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;'>Go to Dashboard</a>
        </p>
      </div>

      <div class='footer'>
        <p>This email was sent automatically. Please do not reply directly.</p>
        <p>&copy; 2026 Intelligent Cloud Plus, Inc. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
