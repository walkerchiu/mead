# Frontend 環境變數 - Dev 環境
# 複製此檔案為 .env 並填入實際值

# ==============================================
# GraphQL API Endpoint
# ==============================================
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://dev-api.yourapp.com/graphql
# NEXT_PUBLIC_GRAPHQL_WS_ENDPOINT=wss://dev-api.yourapp.com/graphql

# ==============================================
# 應用程式配置
# ==============================================
NEXT_PUBLIC_APP_NAME=Starter (Dev)
NEXT_PUBLIC_APP_URL=https://dev.yourapp.com

# ==============================================
# 功能開關
# ==============================================
NEXT_PUBLIC_ENABLE_2FA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
