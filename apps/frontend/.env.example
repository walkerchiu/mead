# Frontend 環境變數 - Local 環境
# 複製此檔案為 .env 並填入實際值

# ==============================================
# GraphQL API Endpoint
# ==============================================
# HTTP Endpoint for queries and mutations
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# WebSocket Endpoint for subscriptions
NEXT_PUBLIC_GRAPHQL_WS_ENDPOINT=ws://localhost:4000/graphql

# ==============================================
# Apollo Client Configuration
# ==============================================
# Request timeout in milliseconds (default: 30000)
# Min: 5000 (5s), Max: 300000 (5min)
NEXT_PUBLIC_APOLLO_TIMEOUT=30000

# Maximum retry attempts (default: 3)
# Min: 0, Max: 10
NEXT_PUBLIC_APOLLO_MAX_RETRIES=3

# Initial retry delay in milliseconds (default: 300)
# Min: 100ms, Max: 60000ms
NEXT_PUBLIC_APOLLO_RETRY_INITIAL_DELAY=300

# Maximum retry delay in milliseconds (default: 10000)
# Min: 100ms, Max: 60000ms
NEXT_PUBLIC_APOLLO_RETRY_MAX_DELAY=10000

# ==============================================
# 應用程式配置
# ==============================================
NEXT_PUBLIC_APP_NAME=Starter (Local)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# 功能開關
# ==============================================
NEXT_PUBLIC_ENABLE_2FA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ==============================================
# 錯誤追蹤 (Sentry)
# ==============================================
# Sentry DSN - 留空則不啟用 Sentry
# 從 https://sentry.io 取得您的 DSN
NEXT_PUBLIC_SENTRY_DSN=

# 應用程式版本資訊 (用於錯誤追蹤)
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_COMMIT_SHA=

# ==============================================
# 開發工具配置
# ==============================================
# 禁用 Next.js DevTools 按鈕（開發環境）
# 設定為 1 則隱藏左上角的 DevTools 按鈕
NEXT_DISABLE_DEVTOOLS=1
