# Frontend 環境變數
# 複製此檔案為 .env 並填入實際值。入口網為純展示、讀同源靜態 plans.json，
# 不需後端設定；以下皆為選填。

# ==============================================
# 應用程式配置
# ==============================================
NEXT_PUBLIC_APP_NAME=MEAD Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# 錯誤追蹤 (Sentry)
# ==============================================
# Sentry DSN - 留空則不啟用 Sentry（從 https://sentry.io 取得）
NEXT_PUBLIC_SENTRY_DSN=

# 應用程式版本資訊 (用於錯誤追蹤)
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_COMMIT_SHA=

# ==============================================
# 開發工具配置
# ==============================================
# 設定為 1 則隱藏左上角的 Next.js DevTools 按鈕
NEXT_DISABLE_DEVTOOLS=1
