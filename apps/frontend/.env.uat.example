# Frontend 環境變數 - UAT 環境
# 複製此檔案為 .env 並填入實際值

# ==============================================
# GraphQL API Endpoint
# ==============================================
# HTTP Endpoint for queries and mutations
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://uat-api.yourapp.com/graphql

# WebSocket Endpoint for subscriptions (如不使用 GraphQL Subscriptions 可保持空白)
NEXT_PUBLIC_GRAPHQL_WS_ENDPOINT=wss://uat-api.yourapp.com/graphql

# ==============================================
# Apollo Client Configuration
# ==============================================
# Request timeout in milliseconds (default: 30000)
# UAT 環境使用稍長的超時時間以模擬生產環境
NEXT_PUBLIC_APOLLO_TIMEOUT=45000

# Maximum retry attempts (default: 3)
# UAT 環境增加重試次數以測試網路不穩定情況
NEXT_PUBLIC_APOLLO_MAX_RETRIES=4

# Initial retry delay in milliseconds (default: 300)
NEXT_PUBLIC_APOLLO_RETRY_INITIAL_DELAY=300

# Maximum retry delay in milliseconds (default: 10000)
NEXT_PUBLIC_APOLLO_RETRY_MAX_DELAY=10000

# ==============================================
# 應用程式配置
# ==============================================
NEXT_PUBLIC_APP_NAME=Starter (UAT)
NEXT_PUBLIC_APP_URL=https://uat.yourapp.com

# ==============================================
# 功能開關
# ==============================================
NEXT_PUBLIC_ENABLE_2FA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ==============================================
# 錯誤追蹤 (Sentry)
# ==============================================
# Sentry DSN - 從 https://sentry.io 取得您的 UAT 環境 DSN
# UAT 環境建議使用獨立的 Sentry 專案
NEXT_PUBLIC_SENTRY_DSN=

# 應用程式版本資訊 (用於錯誤追蹤)
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_COMMIT_SHA=
