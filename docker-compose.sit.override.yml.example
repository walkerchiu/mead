# docker-compose.sit.override.yml.example — Per-host SIT override（疊在 docker-compose.yml 上，gitignored）
#
# 每環境 override 模型，對齊 .env.docker.sit.example：範本（此 .example）tracked → `cp` 成
# docker-compose.sit.override.yml（gitignored）。`.current-env` = sit 時 cli.sh 自動 -f 疊上。
#
# base（docker-compose.yml）不含資源限額；本檔是 SIT 的限額唯一來源。SIT 部署的 apps/backend/.env
# 連線已用 compose service name，故無 dev 那種連線覆寫。下列為 ~2 vCPU / 4 GB 測試機規格。

services:
  timescaledb:
    cpus: 1.5
    mem_limit: 1g
    mem_reservation: 384m

  rabbitmq:
    cpus: 0.3
    mem_limit: 384m
    mem_reservation: 128m

  dragonfly:
    cpus: 0.5
    mem_limit: 384m
    mem_reservation: 128m

  backend:
    cpus: 1.0
    mem_limit: 768m
    mem_reservation: 256m

  frontend:
    cpus: 0.5
    mem_limit: 512m
    mem_reservation: 192m

  mailpit:
    cpus: 0.2
    mem_limit: 128m
    mem_reservation: 32m

  adminer:
    cpus: 0.2
    mem_limit: 128m
    mem_reservation: 32m
