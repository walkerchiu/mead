# docker-compose.staging.override.yml.example — Per-host Staging override（疊在 docker-compose.yml 上，gitignored）
#
# Staging = 生產鏡像（pre-prod）；規格與 prod 對齊。每環境 override 模型，對齊 .env.docker.staging.example：
# 範本 tracked → `cp` 成 docker-compose.staging.override.yml（gitignored）。`.current-env` = staging 時
# cli.sh 自動 -f 疊上。base 不含資源限額；本檔是 Staging 的限額唯一來源；不含 dev 工具（tools 不啟）。
# 下列為 8 vCPU / 16 GB target 規格；換規格時等比例調整。

services:
  timescaledb:
    cpus: 3.0
    mem_limit: 5g
    mem_reservation: 2g

  rabbitmq:
    cpus: 0.5
    mem_limit: 1g
    mem_reservation: 384m

  dragonfly:
    cpus: 1.0
    mem_limit: 2g
    mem_reservation: 512m

  backend:
    cpus: 2.0
    mem_limit: 2g
    mem_reservation: 768m

  frontend:
    cpus: 1.0
    mem_limit: 1g
    mem_reservation: 384m
