{
  "name": "npt",
  "version": "0.1.0",
  "author": {
    "name": "Walker Chiu",
    "email": "walker.chiu@icp-si.com"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "frontend:dev": "pnpm --filter frontend dev",
    "backend:dev": "pnpm --filter backend dev",
    "db:generate": "pnpm --filter @npt/backend db:generate",
    "db:push": "pnpm --filter @npt/backend db:push",
    "db:migrate": "pnpm --filter @npt/backend db:migrate",
    "db:studio": "pnpm --filter @npt/backend db:studio",
    "db:seed": "pnpm --filter @npt/backend db:seed",
    "storybook": "pnpm --filter frontend storybook",
    "build-storybook": "pnpm --filter frontend build-storybook",
    "test": "pnpm --filter @npt/backend test && pnpm --filter @npt/frontend test",
    "test:backend": "pnpm --filter @npt/backend test",
    "test:frontend": "pnpm --filter @npt/frontend test",
    "test:i18n": "pnpm --filter @npt/backend test:i18n && pnpm --filter @npt/frontend test:i18n",
    "test:watch": "turbo run test:watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "html-minifier": "npm:html-minifier-terser@^7.2.0",
      "lodash": "^4.17.23",
      "@isaacs/brace-expansion": ">=5.0.1",
      "fastify": "^5.7.3",
      "qs": ">=6.15.0",
      "handlebars": ">=4.7.9",
      "liquidjs": ">=10.25.7",
      "defu": ">=6.1.5",
      "path-to-regexp": ">=8.4.0",
      "@nestjs/microservices": ">=11.1.19",
      "effect": ">=3.20.0"
    },
    "ignoredBuiltDependencies": [
      "@apollo/protobufjs",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "^1.58.1",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "playwright": "^1.58.2",
    "prettier": "3.8.1",
    "turbo": "^2.8.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.23.0"
}
